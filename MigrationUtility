-- Optional: Automate multiple table loads
DECLARE
  TYPE t_table_list IS TABLE OF VARCHAR2(100);
  tables t_table_list := t_table_list('EMPLOYEES', 'DEPARTMENTS', 'PROJECTS');
  base_url VARCHAR2(4000) := 'https://objectstorage.us-ashburn-1.oraclecloud.com/n/your_namespace/b/your_bucket/o/';
BEGIN
  FOR i IN 1 .. tables.COUNT LOOP
    DBMS_CLOUD.COPY_DATA(
      table_name      => tables(i),
      credential_name => 'OBJ_STORE_CRED',
      file_uri_list   => base_url || LOWER(tables(i)) || '.csv',
      format          => json_object('skipheaders' value '1', 'delimiter' value ',')
    );
    DBMS_OUTPUT.PUT_LINE('Loaded ' || tables(i));
  END LOOP;
END;
/

------------------------------------------------------------------------------
-- Step 4:  Queries for Monitoring
------------------------------------------------------------------------------

-- Check migration summary
SELECT table_name, status, rows_loaded, start_time, end_time
FROM migration_log
ORDER BY log_id DESC;

-- See details for failed loads
SELECT e.table_name, e.error_message, e.error_time, e.stack_trace
FROM migration_error_log e
JOIN migration_log l ON e.log_id = l.log_id
WHERE l.status = 'FAILED';
