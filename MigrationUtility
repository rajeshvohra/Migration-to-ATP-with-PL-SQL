
--Replace your_namespace, your_bucket, and your file URIs with your actual Oracle Cloud details.
--You can adapt this to run for .dmp files if you prefer using impdp via DBMS_DATAPUMP (for full schema imports).
--This script is ideal if your on-prem data is exported as flat files and you just want to automate loading it into ATP.
-- Execute following steps
------------------------------------------------------------------------------
-- Step 0: Create supporting log tables
------------------------------------------------------------------------------

-- Table for tracking migration activity
CREATE TABLE MIGRATION_LOG (
  log_id          NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  table_name      VARCHAR2(128),
  file_uri        VARCHAR2(4000),
  start_time      TIMESTAMP DEFAULT SYSTIMESTAMP,
  end_time        TIMESTAMP,
  status          VARCHAR2(20),
  rows_loaded     NUMBER,
  message         VARCHAR2(4000)
);

-- Table for tracking errors
CREATE TABLE MIGRATION_ERROR_LOG (
  error_id        NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  log_id          NUMBER,
  table_name      VARCHAR2(128),
  error_message   VARCHAR2(4000),
  error_time      TIMESTAMP DEFAULT SYSTIMESTAMP,
  stack_trace     CLOB
);

------------------------------------------------------------------------------
-- Step 1: Create credential (only once)
------------------------------------------------------------------------------

BEGIN
  DBMS_CLOUD.CREATE_CREDENTIAL(
    credential_name => 'OBJ_STORE_CRED',
    username         => 'oraclecloud.storage_user@example.com',
    password         => 'YourAuthTokenHere'
  );
END;
/

------------------------------------------------------------------------------
-- Step 2: Define and run the migration with logging
------------------------------------------------------------------------------

DECLARE
  TYPE t_table_list IS TABLE OF VARCHAR2(128);
  tables      t_table_list := t_table_list('EMPLOYEES', 'DEPARTMENTS', 'PROJECTS');
  base_url    VARCHAR2(4000) := 'https://objectstorage.us-ashburn-1.oraclecloud.com/n/your_namespace/b/your_bucket/o/';
  v_start     TIMESTAMP;
  v_log_id    NUMBER;
  v_row_count NUMBER;
BEGIN
  FOR i IN 1 .. tables.COUNT LOOP
    v_start := SYSTIMESTAMP;

    -- Create a log entry
    INSERT INTO MIGRATION_LOG (table_name, file_uri, start_time, status)
    VALUES (tables(i), base_url || LOWER(tables(i)) || '.csv', v_start, 'RUNNING')
    RETURNING log_id INTO v_log_id;

    COMMIT;

    BEGIN
      -- Attempt to copy data from Object Storage
      DBMS_CLOUD.COPY_DATA(
        table_name      => tables(i),
        credential_name => 'OBJ_STORE_CRED',
        file_uri_list   => base_url || LOWER(tables(i)) || '.csv',
        format          => json_object(
                             'skipheaders' value '1',
                             'delimiter' value ','
                           )
      );

      -- Get row count after load
      EXECUTE IMMEDIATE 'SELECT COUNT(*) FROM ' || tables(i) INTO v_row_count;

      -- Update migration log as successful
      UPDATE MIGRATION_LOG
      SET end_time = SYSTIMESTAMP,
          status = 'SUCCESS',
          rows_loaded = v_row_count,
          message = 'Loaded successfully.'
      WHERE log_id = v_log_id;

      COMMIT;

    EXCEPTION
      WHEN OTHERS THEN
        -- Record error details
        INSERT INTO MIGRATION_ERROR_LOG (log_id, table_name, error_message, stack_trace)
        VALUES (v_log_id, tables(i), SQLERRM, DBMS_UTILITY.format_error_backtrace);

        UPDATE MIGRATION_LOG
        SET end_time = SYSTIMESTAMP,
            status = 'FAILED',
            message = SUBSTR(SQLERRM, 1, 4000)
        WHERE log_id = v_log_id;

        COMMIT;
    END;
  END LOOP;
END;
/
------------------------------------------------------------------------------
-- Step 3: Load CSV data from Object Storage into a table in ATP
------------------------------------------------------------------------------
BEGIN
  DBMS_CLOUD.COPY_DATA(
    table_name      => 'EMPLOYEES',
    credential_name => 'OBJ_STORE_CRED',
    file_uri_list   => 'https://objectstorage.us-ashburn-1.oraclecloud.com/n/your_namespace/b/your_bucket/o/employees.csv',
    format          => json_object(
                         'skipheaders' value '1',
                         'delimiter' value ',',
                         'dateformat' value 'YYYY-MM-DD'
                       )
  );
END;
/

